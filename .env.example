# ============================================
# 複製本檔為 .env (本地測試用);本機 dry-run 只需要「本機 dry-run」區塊的端點與 az login,不用填金鑰
# GitHub Actions 上線時改用 GitHub Secrets
# ============================================

# --- Azure OpenAI (腳本生成 + DALL-E 插畫) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key   # (未使用,保留供舊文件對照)
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_DALLE_DEPLOYMENT=dall-e-3   # (未使用,保留供舊文件對照)
# AZURE_OPENAI_API_VERSION=2024-10-21   # 本機請不要設定 (見檔尾說明)

# --- Azure Speech Service (TTS) ---
AZURE_SPEECH_KEY=your_speech_key   # (未使用,保留供舊文件對照)
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=zh-CN-YunjianNeural

# --- Azure Blob Storage (Podcast 音檔託管) ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=podcast-episodes
AZURE_BLOB_PUBLIC_URL_BASE=https://yourstorageaccount.blob.core.windows.net/podcast-episodes

# --- YouTube Data API v3 ---
YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_refresh_token
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# --- Podcast Metadata ---
PODCAST_TITLE=說書頻道 - 中文歷史故事
PODCAST_AUTHOR=Your Name
PODCAST_EMAIL=you@example.com
PODCAST_BASE_URL=https://yourdomain.com
PODCAST_LANGUAGE=zh-tw
PODCAST_CATEGORY=History

# --- Optional Notification ---
DISCORD_WEBHOOK_URL=

# --- 本機 dry-run (scripts/run_episode_local.py) ---
# 只需要端點與部署名稱,不需要任何金鑰 (改用 az login 的身分)
AZURE_OPENAI_ENDPOINT=https://openai-storyteller-ai-history.openai.azure.com/
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_CUSTOM_DOMAIN=speech-storyteller-ai-history
AZURE_SPEECH_VOICE=zh-CN-YunjianNeural
# AZURE_OPENAI_API_VERSION 本機請不要設定 (未設定時走 v1 路徑)

# --- 分鏡影片 (VIDEO_MODE=shots) ---
VIDEO_MODE=slideshow
VISUAL_STYLE=ink
MAX_IMAGES=24
